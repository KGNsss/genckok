{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "genckok",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "associatedDomains": [
        "applinks:argeaybu.com"
      ],
      "bundleIdentifier": "com.argeaybu.genckok"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E0FFD9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "argeaybu.com",
              "pathPrefix": "/genckok/t"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.argeaybu.genckok"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0FFD9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Fidan künyesindeki QR kodu okutmak ve fidanın fotoğrafını çekmek için kamerana ihtiyacımız var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fidanının fotoğrafını galeriden seçmek için."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
